# ==========================================
# GenMinute 환경 설정 파일 (.env.example)
# ==========================================
# 이 파일을 .env로 복사한 후 값을 입력하세요.
# 복사 명령: cp .env.example .env


# ==================== Flask 설정 ====================

# Flask 앱 시크릿 키 (세션 암호화에 사용)
# 생성 방법: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_flask_secret_key_here

# Flask 디버그 모드 (개발: true / 배포: false)
FLASK_DEBUG=false

# Flask 포트 번호
FLASK_PORT=5000

# CORS 허용 오리진 (쉼표로 구분, 공백 없이)
# 개발: http://localhost:5173   배포: https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 프론트엔드 베이스 URL (Google 캘린더 OAuth 콜백 후 리다이렉트 대상)
# 미설정 시 ALLOWED_ORIGINS의 첫 항목으로 폴백
# 개발: http://localhost:5173   배포: https://your-domain.com
FRONTEND_URL=http://localhost:5173


# ==================== STT 엔진 설정 ====================

# STT 엔진 선택 (local 또는 gemini)
# local  : faster-whisper + pyannote 로컬 모델 (GPU 권장, 무료)
# gemini : Gemini API로 STT + 화자분리 (GPU 불필요, API 비용 발생)
STT_ENGINE=local

# STT 백엔드 세부 선택 (STT_ENGINE=local일 때만 적용)
# auto           : 환경 자동 감지 (OpenVINO 우선)
# faster_whisper : Faster-Whisper 강제 사용
# openvino       : OpenVINO (Intel GPU/NPU) 강제 사용
STT_BACKEND=auto


# ==================== AI 모델 설정 ====================

# Gemini 모델명 (요약, 회의록, 마인드맵, 챗봇 등에 사용)
# 권장: gemini-3-flash (빠르고 저렴, 성능 우수)
# 기타: gemini-2.5-pro, gemini-2.5-flash, gemini-3.1-pro
GEMINI_MODEL=gemini-3-flash

# 벡터 DB(ChromaDB) 임베딩 모델
# ⚠️ 모델 교체 시 차원이 달라져 기존 벡터와 호환되지 않으므로 전체 재임베딩 필요
# 현재 기본값: text-embedding-ada-002 (OpenAIEmbeddings 라이브러리 기본 모델)
EMBEDDING_MODEL=text-embedding-ada-002


# ==================== API 키 ====================

# Google Gemini API 키 (STT, 요약, 회의록, 챗봇용)
# 발급: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key

# OpenAI API 키 (벡터 DB 임베딩용: EMBEDDING_MODEL 참고)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Hugging Face 토큰 (로컬 STT 화자분리 모델 다운로드용)
# STT_ENGINE=local일 때 필수
# 발급: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token





# ==================== Google Calendar 연동 ====================
# Google Cloud Console > OAuth 2.0 클라이언트 ID
# Action Item → 캘린더 자동 등록 기능에 사용

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# GCP 프로젝트 ID (캘린더 OAuth client_secret.json의 선택 필드)
GOOGLE_PROJECT_ID=your_gcp_project_id



# ==================== Gunicorn 설정 (Linux/Mac 배포용) ====================

# 워커 프로세스 수 (권장: CPU 코어 수 * 2 + 1)
GUNICORN_WORKERS=4

# 타임아웃 (초 단위, 대용량 오디오 처리 대비 20분)
GUNICORN_TIMEOUT=1200


# ==================== 프론트엔드 빌드 ====================

# 프론트엔드 빌드 시 API URL (Vite 환경 변수)
# 개발: http://localhost:5000   배포: https://your-api-domain.com
VITE_API_BASE_URL=http://localhost:5000

# 프론트엔드 Supabase 설정 (Vite 환경 변수)
# Supabase 대시보드 > Project Settings > API에서 확인
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key



# ==================== 관리자 설정 ====================

# 관리자 이메일 (쉼표로 구분, 공백 없이)
ADMIN_EMAILS=admin@example.com


# ==================== 로깅 설정 ====================

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO


# ==================== Supabase 설정 ====================
# Supabase 대시보드 > Project Settings > API에서 확인
# Auth + DB 통합 관리

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

